<% content_for :title, "Enter your code" %>
<div class="mx-auto max-w-md card">
  <h1 class="display text-2xl">Enter your code</h1>
  <%= form_with url: verify_identifiers_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :code, "Code", class: "label" %>
      <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric",
            maxlength: 7, class: "input text-center text-2xl tracking-[0.4em] tabular-nums" %>
    </div>
    <%= form.submit "Confirm", class: "btn btn-primary w-full" %>
  <% end %>
</div>

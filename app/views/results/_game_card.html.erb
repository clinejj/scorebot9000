<%# locals: (event:, config:, game_result:) %>
<% game = game_result.game %>
<article class="card">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="font-bold">
      <span class="muted tabular-nums"><%= game.position %>.</span>
      <%= game.id ? link_to(game.name, event_game_path(event, game.position), class: "hover:underline") : game.name %>
    </h3>
    <span class="text-xs muted"><%= game.higher_better? ? "High wins" : "Low wins" %></span>
  </div>
  <% medalists = game_result.rows.select(&:medal) %>
  <% if medalists.any? %>
    <ul class="mt-3 space-y-1.5">
      <% medalists.each do |row| %>
        <li class="flex items-center justify-between gap-3 text-sm">
          <span class="flex min-w-0 items-center gap-2"><%= medal_badge(config, row.medal) %><%= competitor_name(event, row.competitor) %></span>
          <span class="font-semibold tabular-nums"><%= game_value(game, row.value) %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm muted">No scores yet.</p>
  <% end %>
</article>

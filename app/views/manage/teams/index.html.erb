<% content_for :title, "Teams · #{@event.name}" %>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="space-y-3 lg:col-span-2">
    <h2 class="display text-xl">Teams</h2>
    <% @teams.each do |team| %>
      <div class="card">
        <%= form_with model: team, url: manage_event_team_path(@event, team), method: :patch, class: "flex flex-wrap items-center gap-2" do |form| %>
          <%= form.color_field :color, class: "h-9 w-12 rounded" %>
          <%= form.text_field :emoji, class: "input !mt-0 w-16 text-center", maxlength: 8, placeholder: "😀" %>
          <%= form.text_field :name, class: "input !mt-0 min-w-0 flex-1" %>
          <%= form.submit "Save", class: "btn btn-secondary btn-sm" %>
        <% end %>
        <p class="mt-2 text-sm muted"><%= team.participants.map(&:alias_name).sort.to_sentence.presence || "No players" %></p>
        <%= button_to "Delete", manage_event_team_path(@event, team), method: :delete, class: "mt-1 text-xs text-red-700 underline", form: { data: { turbo_confirm: "Delete #{team.name}? Its players become unassigned." } } %>
      </div>
    <% end %>
    <% if @unassigned.any? %>
      <div class="card">
        <h3 class="font-bold">No team (<%= @unassigned.size %>)</h3>
        <p class="mt-1 text-sm muted"><%= @unassigned.map(&:alias_name).to_sentence %></p>
      </div>
    <% end %>
  </section>
  <aside class="space-y-6">
    <section class="card">
      <h2 class="font-bold">Add a team</h2>
      <%= form_with model: @team, url: manage_event_teams_path(@event), class: "mt-3 flex gap-2" do |form| %>
        <%= form.text_field :name, required: true, class: "input !mt-0", placeholder: "Team name" %>
        <%= form.submit "Add", class: "btn btn-primary btn-sm" %>
      <% end %>
    </section>
    <section class="card">
      <h2 class="font-bold">Make teams</h2>
      <p class="mt-1 text-sm muted">Shuffle everyone into teams, or balance the current ones. Leftover players join existing teams (e.g. teams of 2, or 3 if there's an odd number).</p>
      <%= form_with url: randomize_manage_event_teams_path(@event), class: "mt-3 space-y-3" do |form| %>
        <div class="grid grid-cols-2 gap-2">
          <div><%= form.label :team_size, "Team size", class: "label" %><%= form.number_field :team_size, min: 1, class: "input", placeholder: "2" %></div>
          <div><%= form.label :team_count, "or # of teams", class: "label" %><%= form.number_field :team_count, min: 1, class: "input" %></div>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= form.button "Shuffle into teams", name: "mode", value: "shuffle", class: "btn btn-primary btn-sm", data: { turbo_confirm: "Reassign every player at random?" } %>
          <%= form.button "Balance current teams", name: "mode", value: "balance", class: "btn btn-secondary btn-sm" %>
        </div>
      <% end %>
    </section>
  </aside>
</div>

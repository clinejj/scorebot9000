<% content_for :title, "Console" %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <p class="eyebrow">Organizer console</p>
    <h1 class="display mt-1 text-3xl">Your events</h1>
  </div>
  <% if can_host? %>
    <div class="flex gap-2">
      <%= link_to "New series", new_manage_series_path, class: "btn btn-secondary" %>
      <%= link_to "New event", new_manage_event_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<% if @events.any? %>
  <div class="mt-6 card !p-0 overflow-x-auto">
    <table class="table-scores">
      <thead><tr><th>Event</th><th>Status</th><th>Date</th><th>Players</th><th></th></tr></thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= link_to event.name, manage_event_path(event), class: "font-semibold hover:underline" %><br><span class="text-xs muted"><%= event.series&.name %></span></td>
            <td><%= status_pill(event) %></td>
            <td class="whitespace-nowrap"><%= event_date(event, format: :short) %></td>
            <td class="tabular-nums"><%= event.participants.size %></td>
            <td class="text-right"><%= link_to "Scores", manage_event_score_sheets_path(event), class: "underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="mt-6 card">
    <% if can_host? %>
      <p>No events yet. <%= link_to "Create your first event", new_manage_event_path, class: "underline" %>.</p>
    <% else %>
      <p>You don't manage any events yet. When an organizer adds you, they'll show up here.</p>
    <% end %>
  </div>
<% end %>

<% if @series_list.any? %>
  <h2 class="display mt-10 text-xl">Series</h2>
  <div class="mt-3 flex flex-wrap gap-2">
    <% @series_list.each do |series| %>
      <%= link_to series.name, edit_manage_series_path(series), class: "btn btn-secondary btn-sm" %>
    <% end %>
  </div>
<% end %>

<%# locals: (series:, url:, method:) %>
<%= form_with model: series, url: url, method: method, class: "space-y-6" do |form| %>
  <% if series.errors.any? %><p class="flash flash-alert"><%= series.errors.full_messages.to_sentence %></p><% end %>
  <section class="card space-y-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= form.label :name, class: "label" %><%= form.text_field :name, required: true, class: "input" %></div>
      <% if series.persisted? %><div><%= form.label :slug, "Page address", class: "label" %><div class="flex items-center gap-1"><span class="mt-1 text-sm muted">/s/</span><%= form.text_field :slug, class: "input" %></div></div><% end %>
      <div class="sm:col-span-2"><%= form.label :tagline, class: "label" %><%= form.text_field :tagline, class: "input" %></div>
      <div><%= form.label :accent_color, "Accent color", class: "label" %><%= form.color_field :accent_color, value: series.accent_color || "#4338ca", class: "mt-1 h-11 w-20 rounded-lg" %></div>
      <% if current_user.platform_admin? %>
        <div><%= form.label :custom_domain, class: "label" %><%= form.text_field :custom_domain, class: "input", placeholder: "clinelympics.com" %><p class="hint">Also needs <code>fly certs add</code> and DNS at Cloudflare.</p></div>
      <% end %>
      <div><%= form.label :logo, class: "label" %><%= form.file_field :logo, accept: "image/*", class: "mt-2 block text-sm" %></div>
      <div><%= form.label :hero, "Header image", class: "label" %><%= form.file_field :hero, accept: "image/*", class: "mt-2 block text-sm" %></div>
    </div>
    <div><%= form.label :description, class: "label" %><%= form.rich_textarea :description, class: "input min-h-32" %></div>
  </section>
  <% if series.persisted? %>
    <section class="card">
      <h2 class="font-bold">Random player names</h2>
      <p class="text-sm muted"><%= @pool ? "#{@pool.aliases.count} names in #{@pool.name}." : "No name pool yet; events use the platform defaults." %> Add names, one per line.</p>
      <%= text_area_tag "series[alias_names]", nil, rows: 5, class: "input font-mono text-sm", placeholder: "Usain Bolt\nSerena Williams" %>
    </section>
  <% end %>
  <%= form.submit series.persisted? ? "Save" : "Create series", class: "btn btn-primary" %>
<% end %>

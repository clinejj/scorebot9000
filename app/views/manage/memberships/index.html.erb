<% content_for :title, "Organizers · #{@event.name}" %>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <h2 class="display text-xl">Organizers</h2>
    <p class="text-sm muted"><strong>Owners</strong> manage everything including this list. <strong>Organizers</strong> run the event. <strong>Scorekeepers</strong> can only enter scores.</p>
    <ul class="mt-4 divide-y divide-stone-100 dark:divide-stone-800">
      <% @series_memberships.each do |membership| %>
        <li class="flex items-center justify-between py-2 text-sm"><span><%= membership.user.email || membership.user.display_name %> <span class="muted">· series <%= membership.role %></span></span></li>
      <% end %>
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between py-2 text-sm">
          <span><%= membership.user.email || membership.user.display_name %> <span class="muted">· <%= membership.role %></span></span>
          <% if allowed_to?(:own?, @event) %>
            <%= button_to "Remove", manage_event_membership_path(@event, membership), method: :delete, class: "text-xs text-red-700 underline" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
  <% if allowed_to?(:own?, @event) %>
    <section class="card">
      <h2 class="font-bold">Add someone</h2>
      <%= form_with url: manage_event_memberships_path(@event), class: "mt-3 space-y-3" do |form| %>
        <div><%= form.label :email, class: "label" %><%= form.email_field :email, required: true, class: "input" %></div>
        <div><%= form.label :role, class: "label" %><%= form.select :role, [ [ "Scorekeeper", "scorekeeper" ], [ "Organizer", "organizer" ], [ "Owner", "owner" ] ], {}, class: "input" %></div>
        <%= form.submit "Add", class: "btn btn-primary" %>
      <% end %>
    </section>
  <% end %>
</div>

<% content_for :title, "#{@game.name} scores · #{@event.name}" %>
<div class="flex flex-wrap items-center justify-between gap-3">
  <div>
    <p class="eyebrow">Game <%= @game.position %> · <%= @game.higher_better? ? "high wins" : "low wins" %> · <%= @game.scored_by_team? ? "one score per team" : "every player" %></p>
    <h2 class="display mt-1 text-2xl"><%= @game.name %></h2>
  </div>
  <div class="flex gap-2">
    <% if (previous = @event.games.find_by(position: @game.position - 1)) %><%= link_to "← #{previous.name}", manage_event_score_sheet_path(@event, previous), class: "btn btn-secondary btn-sm" %><% end %>
    <% if (following = @event.games.find_by(position: @game.position + 1)) %><%= link_to "#{following.name} →", manage_event_score_sheet_path(@event, following), class: "btn btn-secondary btn-sm" %><% end %>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-5">
  <section class="card lg:col-span-3">
    <% if @event.finished? %>
      <p class="flash flash-alert">Results are final. Reopen the event to make corrections.</p>
    <% end %>
    <%= form_with url: manage_event_score_sheet_path(@event, @game), method: :patch, class: "space-y-2" do |form| %>
      <p class="text-sm muted">Type a score and press Tab to move down. Enter <%= @game.score_hint %>. Unchanged rows are skipped.</p>
      <% @competitors.each do |competitor| %>
        <div class="flex items-center gap-3">
          <label for="score_<%= competitor.public_id %>" class="min-w-0 flex-1 truncate font-semibold">
            <%= competitor.display_name %>
            <% if competitor.respond_to?(:team) && competitor.team %><span class="text-xs font-normal muted">· <%= competitor.team.name %></span><% end %>
          </label>
          <%= text_field_tag "scores[#{competitor.public_id}]", (@current[competitor.id] && @game.format_value(@current[competitor.id])),
                id: "score_#{competitor.public_id}", inputmode: "decimal", autocomplete: "off", class: "input !mt-0 w-32 text-right tabular-nums", disabled: @event.finished? %>
        </div>
      <% end %>
      <%= form.submit "Save scores", class: "btn btn-primary mt-4", disabled: @event.finished? || @competitors.empty? %>
    <% end %>
  </section>
  <section class="card lg:col-span-2">
    <h3 class="font-bold">Recent entries</h3>
    <ul class="mt-3 space-y-2 text-sm">
      <% @recent.each do |entry| %>
        <li class="flex items-center justify-between gap-3 <%= "opacity-50 line-through" if entry.voided? %>">
          <span class="min-w-0">
            <strong><%= entry.competitor.display_name %></strong> <%= entry.display_value %>
            <span class="block text-xs muted"><%= entry.source %><%= " by #{entry.submitted_by_user.display_name}" if entry.submitted_by_user %> · <%= time_ago_in_words(entry.created_at) %> ago<%= " · #{entry.note}" if entry.note.present? %></span>
          </span>
          <% unless entry.voided? || @event.finished? %>
            <%= button_to "Void", manage_event_score_entry_path(@event, entry), method: :delete, class: "text-xs text-red-700 underline" %>
          <% end %>
        </li>
      <% end %>
      <% if @recent.empty? %><li class="muted">No scores yet.</li><% end %>
    </ul>
  </section>
</div>

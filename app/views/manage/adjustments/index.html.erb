<% content_for :title, "Adjustments · #{@event.name}" %>
<div class="grid gap-6 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <h2 class="display text-xl">Adjustments</h2>
    <p class="text-sm muted">Bonus or penalty points, shown on the results page with their reason. They count for point-based standings (not the Olympic medal table or average rank).</p>
    <ul class="mt-4 divide-y divide-stone-100 dark:divide-stone-800">
      <% @adjustments.each do |adjustment| %>
        <li class="flex items-center justify-between gap-3 py-2 text-sm">
          <span><strong><%= adjustment.points.positive? ? "+" : "" %><%= ScoreValue.trim(adjustment.points) %></strong> <%= adjustment.competitor.display_name %>: <%= adjustment.reason %></span>
          <%= button_to "Remove", manage_event_adjustment_path(@event, adjustment), method: :delete, class: "text-xs text-red-700 underline" %>
        </li>
      <% end %>
      <% if @adjustments.empty? %><li class="py-2 text-sm muted">None yet.</li><% end %>
    </ul>
  </section>
  <section class="card">
    <h2 class="font-bold">Add an adjustment</h2>
    <%= form_with url: manage_event_adjustments_path(@event), class: "mt-3 space-y-3" do |form| %>
      <% options = (@event.teams.map { |team| [ "Team: #{team.name}", team.public_id ] } + @event.participants.order(:alias_name).map { |participant| [ participant.alias_name, participant.public_id ] }) %>
      <div><%= form.label :competitor_id, "Who", class: "label" %><%= form.select :competitor_id, options, {}, class: "input" %></div>
      <div><%= form.label :points, class: "label" %><%= form.number_field :points, step: 0.5, required: true, class: "input", placeholder: "1 or -1" %></div>
      <div><%= form.label :reason, class: "label" %><%= form.text_field :reason, required: true, maxlength: 140, class: "input", placeholder: "Best uniforms" %></div>
      <%= form.submit "Add", class: "btn btn-primary" %>
    <% end %>
  </section>
</div>

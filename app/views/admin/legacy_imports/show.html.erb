<% content_for :title, "Legacy import report" %>
<% report = @legacy_import.report %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <p class="eyebrow">Legacy import · <%= @legacy_import.status %></p>
    <h1 class="display mt-2 text-3xl">Reconciliation report</h1>
  </div>
  <% unless @legacy_import.running? || @dump_error %>
    <%= button_to (@legacy_import.uploaded? ? "Run import" : "Re-run import"), run_admin_legacy_import_path(@legacy_import), class: "btn btn-primary" %>
  <% end %>
</div>

<% if @dump_error %>
  <p class="mt-6 flash flash-alert"><%= @dump_error %></p>
<% else %>
  <section class="mt-6 card">
    <h2 class="font-bold">Counts</h2>
    <table class="table-scores mt-3">
      <thead><tr><th>Kind</th><th>In dump</th><th>Imported</th></tr></thead>
      <tbody>
        <% (@source_counts.keys | report.fetch("counts", {}).keys).each do |kind| %>
          <% counts = report.dig("counts", kind) || report.dig("counts", kind.pluralize) || {} %>
          <tr>
            <td><%= kind %></td>
            <td><%= @source_counts[kind] || counts["source"] %></td>
            <td><%= counts["imported"] || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if report["completed_steps"].present? %>
      <p class="mt-3 text-sm muted">Completed steps: <%= report["completed_steps"].join(", ") %></p>
    <% end %>
  </section>

  <% if report["events"].present? %>
    <section class="mt-6 card">
      <h2 class="font-bold">Official results by event</h2>
      <ul class="mt-3 space-y-3">
        <% report["events"].sort_by { |id, _| id.to_i }.each do |legacy_id, details| %>
          <li>
            <p class="font-semibold"><%= details["name"] %> <span class="muted text-sm">(legacy #<%= legacy_id %>, <%= details["snapshot"] == "legacy_capture" ? "as announced" : "recomputed" %>)</span></p>
            <% if details["diffs"].present? %>
              <ul class="mt-1 list-disc pl-5 text-sm">
                <% details["diffs"].each do |diff| %><li><%= diff %></li><% end %>
              </ul>
            <% else %>
              <p class="text-sm muted">Recomputed results match.</p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="mt-4 text-sm muted">Differences don't change what's displayed (the announced results are official). To make the raw data agree, run <code>Maintenance::Legacy::ReconcileResultsTask</code>.</p>
    </section>
  <% end %>

  <% if report["warnings"].present? %>
    <section class="mt-6 card">
      <h2 class="font-bold">Warnings</h2>
      <% report["warnings"].each do |category, messages| %>
        <h3 class="mt-4 text-sm font-bold uppercase tracking-wider muted"><%= category.humanize %> (<%= messages.size %>)</h3>
        <ul class="mt-1 list-disc pl-5 text-sm">
          <% messages.first(50).each do |message| %><li><%= message %></li><% end %>
          <% if messages.size > 50 %><li>…and <%= messages.size - 50 %> more</li><% end %>
        </ul>
      <% end %>
    </section>
  <% end %>
<% end %>

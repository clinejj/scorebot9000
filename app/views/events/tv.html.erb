<% content_for :title, "TV · #{@event.name}" %>
<% config = @result.config %>
<% rows = @result.standings.select(&:place).first(10) %>
<div class="flex h-dvh flex-col p-6 lg:p-10" data-controller="auto-refresh" data-auto-refresh-interval-value="<%= @event.live? ? 15 : 120 %>">
  <header class="flex items-center justify-between gap-6">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent"><%= @event.series&.name %></p>
      <h1 class="display text-4xl lg:text-6xl"><%= @event.name %></h1>
    </div>
    <div class="text-right">
      <%= status_pill(@event) %>
      <% if sms_instructions?(@event) %>
        <p class="mt-2 text-lg text-white/70">Text <span class="font-mono font-bold text-white">SCORE &lt;game&gt; &lt;score&gt;</span> to <span class="font-bold text-white"><%= sms_number %></span></p>
      <% end %>
    </div>
  </header>

  <div class="mt-8 grid min-h-0 flex-1 gap-8 lg:grid-cols-5">
    <section class="lg:col-span-3">
      <ol class="space-y-3">
        <% rows.each do |row| %>
          <li class="flex items-center gap-5 rounded-2xl bg-white/5 px-5 py-3 ring-1 ring-white/10">
            <span class="w-12 text-center text-4xl font-black tabular-nums" style="<%= "color: #{config.medals[row.place - 1]["color"]}" if row.place && row.place <= config.medals.size %>"><%= row.place %></span>
            <span class="h-10 w-2 rounded-full" style="background-color: <%= row.competitor.color || "#57534e" %>"></span>
            <span class="min-w-0 flex-1 truncate text-3xl font-bold"><%= row.competitor.name %></span>
            <span class="flex gap-2">
              <% row.medal_counts.each_with_index do |count, index| %>
                <span class="flex items-center gap-1 text-xl tabular-nums <%= "opacity-30" if count.zero? %>"><span class="inline-block h-4 w-4 rounded-full" style="background-color: <%= config.medals[index]["color"] %>"></span><%= count %></span>
              <% end %>
            </span>
            <span class="w-24 text-right text-4xl font-black tabular-nums"><%= points(row.total) %></span>
          </li>
        <% end %>
      </ol>
    </section>

    <section class="min-h-0 lg:col-span-2" data-controller="rotate" data-rotate-interval-value="10">
      <% @result.game_results.each do |game_result| %>
        <div data-rotate-target="panel" class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-white/60">Game <%= game_result.game.position %></p>
          <h2 class="display mt-1 text-4xl"><%= game_result.game.name %></h2>
          <ol class="mt-6 space-y-3">
            <% game_result.rows.first(6).each do |row| %>
              <li class="flex items-center justify-between gap-4 text-2xl">
                <span class="flex min-w-0 items-center gap-3">
                  <span class="w-8 font-black tabular-nums text-white/60"><%= row.place %></span>
                  <% if row.medal %><span class="inline-block h-5 w-5 rounded-full" style="background-color: <%= config.medals[row.medal]["color"] %>"></span><% end %>
                  <span class="truncate font-semibold"><%= row.competitor.name %></span>
                </span>
                <span class="font-black tabular-nums"><%= game_value(game_result.game, row.value) %></span>
              </li>
            <% end %>
            <% if game_result.rows.empty? %><li class="text-2xl text-white/50">Waiting for scores…</li><% end %>
          </ol>
        </div>
      <% end %>
    </section>
  </div>
</div>

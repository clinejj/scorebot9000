<% content_for :title, "Host an event" %>
<div class="mx-auto max-w-lg card">
  <p class="eyebrow">Host on Scorebot 9000</p>
  <h1 class="display mt-1 text-2xl">Host an event</h1>
  <% if @pending %>
    <p class="mt-3">Your request from <%= l @pending.created_at.to_date, format: :long %> is waiting for review. We'll email you when you're approved.</p>
  <% else %>
    <p class="mt-2 muted">Hosting is invite-only for now. Tell us a little about your event and we'll get you set up.</p>
    <%= form_with model: @host_request, url: host_path, class: "mt-5 space-y-4" do |form| %>
      <% if @host_request.errors.any? %><p class="flash flash-alert"><%= @host_request.errors.full_messages.to_sentence %></p><% end %>
      <div>
        <%= form.label :message, "What are you planning?", class: "label" %>
        <%= form.text_area :message, rows: 4, maxlength: 2000, class: "input", placeholder: "A backyard games day for ~20 friends in June, 6 games, teams of 2." %>
      </div>
      <%= form.submit "Request access", class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>
